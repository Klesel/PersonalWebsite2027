---
import EmailLink from './EmailLink.astro';
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  title?: string;
  text?: string;
}

const { locale, title = t(locale, 'cta.band.title'), text = t(locale, 'cta.band.text') } = Astro.props;
---

<section class="cta-band" aria-labelledby="cta-band-title">
  <div class="container cta-band__inner">
    <div>
      <h2 id="cta-band-title">{title}</h2>
      <p>{text}</p>
    </div>
    <div class="button-row">
      <EmailLink locale={locale} topic="keynote" label={t(locale, 'cta.keynote')} class="button cta-band__primary" icon />
      <EmailLink locale={locale} topic="consulting" label={t(locale, 'cta.consulting')} class="button button--secondary cta-band__secondary" />
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-block: clamp(3rem, 7vw, 5rem);
    background:
      radial-gradient(60rem 30rem at 100% 0%, color-mix(in srgb, var(--color-inverse-accent) 18%, transparent), transparent 60%),
      var(--color-inverse-bg);
    color: var(--color-inverse-text);
  }

  .cta-band__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  h2 {
    color: var(--color-inverse-text);
    max-width: 32rem;
  }

  p {
    margin-top: 0.75rem;
    max-width: 34rem;
    color: var(--color-inverse-muted);
    font-size: var(--text-lg);
  }

  .cta-band__primary {
    background: var(--color-inverse-text);
    border-color: var(--color-inverse-text);
    color: var(--color-inverse-bg);
  }

  .cta-band__primary:hover {
    background: var(--color-inverse-muted);
    border-color: var(--color-inverse-muted);
    color: var(--color-inverse-bg);
  }

  .cta-band__secondary {
    border-color: var(--color-inverse-muted);
    color: var(--color-inverse-text);
  }

  .cta-band__secondary:hover {
    background: color-mix(in srgb, var(--color-inverse-text) 12%, transparent);
    border-color: var(--color-inverse-text);
    color: var(--color-inverse-text);
  }
</style>
