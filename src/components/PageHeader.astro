---
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
}

const { title, eyebrow, lead } = Astro.props;
---

<header class="page-header">
  <div class="container">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header {
    padding-block: clamp(3rem, 8vw, 5.5rem) clamp(2.5rem, 6vw, 4rem);
    background:
      radial-gradient(50rem 22rem at 90% -10%, var(--color-accent-soft), transparent 70%),
      var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  h1 {
    max-width: 48rem;
  }

  .lead {
    max-width: 44rem;
    margin-top: 1.25rem;
  }
</style>
