---
import Icon from './Icon.astro';
import site from '../data/site.json';
import { otherLocale, routes, t, type Alternates, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  alternates: Alternates;
}

const { locale, alternates } = Astro.props;
const other = otherLocale(locale);
const path = Astro.url.pathname;

const items = (['keynotes', 'consulting', 'about', 'publications'] as const).map((key) => ({
  href: routes[key][locale],
  label: t(locale, `nav.${key}`),
  current: path.startsWith(routes[key][locale]),
}));
const contactHref = routes.contact[locale];
---

<header class="site-header">
  <a class="skip-link" href="#main">{t(locale, 'nav.skip')}</a>
  <div class="container site-header__inner">
    <a class="brand" href={routes.home[locale]} aria-current={path === routes.home[locale] ? 'page' : undefined}>
      <span class="brand__name">{site.name}</span>
      <span class="brand__role">{site.jobTitle[locale]}</span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-menu-toggle
    >
      <Icon name="menu" class="menu-toggle__open" />
      <Icon name="close" class="menu-toggle__close" />
      <span class="visually-hidden">{t(locale, 'nav.menu')}</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label={t(locale, 'nav.label')} data-menu>
      <ul class="site-nav__list">
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={item.current ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="site-nav__actions">
        <a
          class="lang-switch"
          href={alternates[other]}
          hreflang={other}
          lang={other}
          aria-label={t(locale, 'lang.switch')}
          title={t(locale, 'lang.switch')}
        >
          <Icon name="globe" size={18} />
          {t(locale, 'lang.short')}
        </a>
        <button
          class="theme-toggle"
          type="button"
          data-theme-toggle
          data-label-dark={t(locale, 'theme.toDark')}
          data-label-light={t(locale, 'theme.toLight')}
          aria-label={t(locale, 'theme.toggle')}
          title={t(locale, 'theme.toggle')}
        >
          <Icon name="moon" class="theme-toggle__moon" />
          <Icon name="sun" class="theme-toggle__sun" />
        </button>
        <a
          class="button header-cta"
          href={contactHref}
          aria-current={path.startsWith(contactHref) ? 'page' : undefined}
        >
          {t(locale, 'nav.contact')}
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  // Colour scheme switch
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  function updateLabel() {
    if (!toggle) return;
    const label = root.dataset.theme === 'dark' ? toggle.dataset.labelLight : toggle.dataset.labelDark;
    if (label) {
      toggle.setAttribute('aria-label', label);
      toggle.title = label;
    }
  }

  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
    updateLabel();
  });

  // Follow the system setting until the visitor makes an explicit choice.
  media.addEventListener('change', (event) => {
    let stored = null;
    try {
      stored = localStorage.getItem('theme');
    } catch {}
    if (!stored) {
      root.dataset.theme = event.matches ? 'dark' : 'light';
      updateLabel();
    }
  });

  updateLabel();

  // Mobile menu
  const menuButton = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');

  function setMenu(open: boolean) {
    menuButton?.setAttribute('aria-expanded', String(open));
    menu?.classList.toggle('is-open', open);
  }

  menuButton?.addEventListener('click', () => {
    setMenu(menuButton.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuButton?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      menuButton.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: saturate(180%) blur(12px);
    -webkit-backdrop-filter: saturate(180%) blur(12px);
    border-bottom: 1px solid var(--color-border);
  }

  .skip-link {
    position: absolute;
    left: 1rem;
    top: -4rem;
    z-index: 100;
    padding: 0.6rem 1rem;
    border-radius: var(--radius-sm);
    background: var(--color-accent);
    color: var(--color-accent-contrast);
    font-weight: 600;
  }

  .skip-link:focus {
    top: 0.75rem;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.5rem;
  }

  .brand {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    text-decoration: none;
    color: var(--color-primary);
  }

  .brand__name {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 600;
  }

  .brand__role {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.75rem;
  }

  .site-nav__list {
    display: flex;
    gap: 1.5rem;
    list-style: none;
    padding: 0;
  }

  .site-nav__list a {
    position: relative;
    padding-block: 0.4rem;
    color: var(--color-text);
    font-weight: 500;
    text-decoration: none;
  }

  .site-nav__list a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transition: transform 0.2s ease;
  }

  .site-nav__list a:hover::after,
  .site-nav__list a[aria-current='page']::after {
    transform: scaleX(1);
  }

  .site-nav__list a[aria-current='page'] {
    color: var(--color-accent);
  }

  .site-nav__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .lang-switch,
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-width: 2.75rem;
    height: 2.75rem;
    padding: 0 0.6rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
  }

  .lang-switch:hover,
  .theme-toggle:hover {
    border-color: var(--color-border);
    background: var(--color-bg-subtle);
    color: var(--color-text);
  }

  .header-cta {
    margin-left: 0.5rem;
    min-height: 2.5rem;
    padding: 0.5rem 1.15rem;
  }

  .theme-toggle__sun,
  :global([data-theme='dark']) .theme-toggle__moon {
    display: none;
  }

  :global([data-theme='dark']) .theme-toggle__sun {
    display: block;
  }

  .menu-toggle {
    display: none;
  }

  /* ---------- Small screens ---------- */
  @media (max-width: 60rem) {
    :global(.js) .menu-toggle {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      height: 2.75rem;
      border: 1px solid var(--color-border);
      border-radius: 999px;
      background: transparent;
      color: var(--color-text);
      cursor: pointer;
    }

    .menu-toggle__close,
    .menu-toggle[aria-expanded='true'] .menu-toggle__open {
      display: none;
    }

    .menu-toggle[aria-expanded='true'] .menu-toggle__close {
      display: block;
    }

    .site-header__inner {
      flex-wrap: wrap;
    }

    .site-nav {
      flex-basis: 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 1rem;
      padding-bottom: 1.25rem;
    }

    :global(.js) .site-nav:not(.is-open) {
      display: none;
    }

    .site-nav__list {
      flex-direction: column;
      gap: 0;
    }

    .site-nav__list a {
      display: block;
      padding-block: 0.75rem;
      border-bottom: 1px solid var(--color-border);
    }

    .site-nav__list a::after {
      display: none;
    }

    .header-cta {
      margin-left: auto;
    }
  }
</style>
