@inproceedings{klesel_maturing_2015,
    location = {Puerto Rico},
    title = {Maturing, Flagshipping and Piggybacking: On the Use of Structuration Theory in Information Systems Research},
    booktitle = {21st Americas Conference on Information Systems},
    author = {Klesel, Michael and Mokosch, Gunnar and Niehaves, Björn},
    year = {2015},
    abstract = {The debate on structure and agency has a long-standing tradition in the social sciences. Developed by the British sociologist Anthony Giddens, Structuration Theory proposed the "duality of structure", the notion that structure and agency are inseparable in practice. Information Systems (IS) researchers have developed IS-specific adaptations of Giddens's ideas. We add to previous reviews on the use of Structuration Theory in IS by focusing on the adoption of individual concepts set forth by the theory and its IS adaptations. Based on our analysis of references to these concepts in the major journals and conferences we argue that the use of Structuration Theory in IS has matured over the past decade. We also find that some structurational concepts are frequently used as flagships and in combination ("piggybacked"). Finally, we plead in favor of a more widespread use of agency as a fundamental concept of Giddens's theory.}
}

@inproceedings{mokosch_putting_2015,
    location = {Puerto Rico},
    title = {Putting Flesh on the Duality of Structure: The Case of {IT} Consumerization},
    shorttitle = {Putting flesh on the Duality of Structure: the case of {IT} Consumerization},
    booktitle = {21st Americas Conference on Information Systems},
    author = {Mokosch, Gunnar and Klesel, Michael and Niehaves, Björn},
    year = {2015},
    abstract = {The use of consumer IT at work, known as "IT Consumerization", is changing the dynamic between employees and IT departments. Employees are empowered and now have greater freedom but also responsibility as to what technologies to use at work and how. At the same time, organizational factors such as rules on technology use still exert considerable influence on employees' actions. Drawing on Structuration Theory, we frame this interaction between organization and employee as one of structure and agency. In the process, we pursue an explorative approach and rely on qualitative data from interviews with public-sector employees. We identify four organizational structures that influence people's behavior with respect to IT Consumerization: policies, equipment, tasks and authority. By spotlighting the mutual influence of these organizational structures and Consumerization-related behavior, we show Giddens's duality of structure in action and demonstrate its relevance to the study of IT Consumerization.}
}