---
import { Picture } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import PageHeader from '../components/PageHeader.astro';
import portrait from '../assets/portrait.jpg';
import site from '../data/site.json';
import { routes, t, type Locale } from '../i18n';
import { getPage } from '../lib/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = await getPage('about', locale);
const { Content } = await render(page);
---

<BaseLayout locale={locale} title={page.data.title} description={page.data.description} alternates={routes.about}>
  <PageHeader title={page.data.title} eyebrow={page.data.eyebrow} lead={page.data.lead} />

  <section class="section">
    <div class="container about">
      <div class="about__media">
        <Picture
          src={portrait}
          alt={`${site.honorific} ${site.name}`}
          formats={['avif', 'webp']}
          widths={[320, 480, 640]}
          sizes="(min-width: 60rem) 20rem, 80vw"
        />
        <div class="about__facts">
          <p><strong>{site.jobTitle[locale]}</strong></p>
          <p><a href={site.affiliation.url} target="_blank" rel="noopener">{site.affiliation.name}</a></p>
          <p>{site.affiliation.department[locale]}</p>
        </div>
        <ul class="about__profiles" aria-label={t(locale, 'footer.profiles')}>
          {
            site.profiles.map((p) => (
              <li>
                <a href={p.url} target="_blank" rel="me noopener">
                  {p.label}
                  <Icon name="external" size={14} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="prose about__text">
        <Content />
      </div>
    </div>
  </section>

  {
    page.data.sections && (
      <section class="section section--subtle" aria-labelledby="focus-title">
        <div class="container">
          <h2 id="focus-title" class="section__header">{t(locale, 'about.focus')}</h2>
          <div class="focus">
            {page.data.sections.map((item) => (
              <div class="card focus__item">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand locale={locale} />
</BaseLayout>

<style>
  .about {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .about {
      grid-template-columns: 20rem minmax(0, 1fr);
    }
  }

  .about__media {
    display: grid;
    gap: 1.5rem;
    max-width: 20rem;
  }

  .about__media :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: calc(var(--radius) * 1.5);
  }

  .about__facts {
    color: var(--color-text-muted);
  }

  .about__facts strong {
    color: var(--color-text);
  }

  .about__profiles {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .about__profiles a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--color-text);
  }

  .about__profiles a:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .about__text {
    font-size: 1.1rem;
  }

  .focus {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
  }

  .focus__item {
    padding: 1.5rem;
  }

  .focus__item h3 {
    font-size: 1.15rem;
    margin-bottom: 0.5rem;
  }

  .focus__item p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }
</style>
